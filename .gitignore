# Archivos de soporte local
project-info.md

# Dependencias y tipos generados por AGS
node_modules/
@girs/

# Archivos generados por la aplicación
src/themes/base.js
src/themes/current-theme.json
src/themes/theme.json
src/config/privateConfig.js
src/themes/themes/*.json
!src/themes/themes/default.json

# Scripts locales para adaptar aplicaciones externas a cada tema.
# Se ignora el contenido, pero se conserva la carpeta con su .gitkeep.
src/services/theme_scripts/*

# Temporales, cachés y logs
tmp/
*.tmp
*.cache
*.log

# Variables de entorno y secretos locales
.env
.env.*
!.env.example

# Configuración del editor
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# Archivos del sistema
.DS_Store
Thumbs.db
